+def routing_policy(path: str) -> str:
+    """Carry root-owned routing choices through unrelated GUI changes."""
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+    except FileNotFoundError:
+        return ""
+    except OSError as error:
+        die(f"cannot read routing policy: {error}")
+    with os.fdopen(fd, "r", encoding="utf-8", errors="replace") as existing:
+        status = os.fstat(existing.fileno())
+        if status.st_uid != 0 or status.st_mode & 0o022:
+            die("refusing to preserve routing policy from an untrusted file")
+        text = existing.read(65537)
+    if len(text) > 65536:
+        die("existing routing configuration is oversized")
+    values = {}
+    for line in text.splitlines():
+        line = line.split("#", 1)[0].strip()
+        if "=" in line:
+            key, value = (part.strip() for part in line.split("=", 1))
+            if key in ("NATIVE_DEFAULT", "FALLBACK_APPS"):
+                values[key] = value
+    lines = []
+    if "NATIVE_DEFAULT" in values:
+        try:
+            enabled = parse_bool(values["NATIVE_DEFAULT"])
+        except ValueError as error:
+            die(f"invalid existing native-default policy: {error}")
+        lines.append("NATIVE_DEFAULT = " + ("true" if enabled else "false"))
+    if "FALLBACK_APPS" in values:
+        apps = [app.strip() for app in values["FALLBACK_APPS"].split(",") if app.strip()]
+        if len(apps) > 32 or any(
+                len(app) > 128 or not re.fullmatch(r"[A-Za-z0-9_.-]+", app)
+                for app in apps):
+            die("invalid existing fallback application policy")
+        lines.append("FALLBACK_APPS = " + ", ".join(apps))
+    return "\n" + "\n".join(lines) + "\n" if lines else ""
+
+
 def main(argv):
