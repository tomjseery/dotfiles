[Unit]
Description=Native pointer-target helper for midscroll
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/midscroll-router
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=graphical-session.target
