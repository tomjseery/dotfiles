#!/usr/bin/env bash
set -euo pipefail
module=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd -- "$module"
uv sync --locked
uv run ruff format --check src tests
uv run ruff check src tests
uv run mypy
prepared=$(uv run python -m midscroll_routing.source --module "$module" \
  --cache "${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/mouse-builds")
MIDSCROLL_PREPARED_SOURCE="$prepared" uv run pytest
printf 'Prepared source: %s\n' "$prepared"
