#!/usr/bin/env bash
set -euo pipefail

integration_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
"$integration_dir/../../../mouse/apps/chromium/install-user"

# KWallet being locked/misconfigured must never be able to hang Chrome again:
# keep Chrome on its own internal credential store instead of the desktop
# keyring.
chrome_flags="$config_home/chrome-flags.conf"
touch "$chrome_flags"
if ! grep -q '^--password-store=basic$' "$chrome_flags"; then
  printf -- '--password-store=basic\n' >>"$chrome_flags"
fi
