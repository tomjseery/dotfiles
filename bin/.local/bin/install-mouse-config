#!/usr/bin/env bash
set -euo pipefail

script_path=$(readlink -f "${BASH_SOURCE[0]}")
repo_root=$(cd "$(dirname "$script_path")/../../.." && pwd)
input_remapper_policy="$repo_root/mouse/input-remapper-config.json"
input_remapper_merger="$repo_root/mouse/apply-input-remapper-config.py"

install_system_config() {
    if [[ $EUID -ne 0 ]]; then
        printf 'The internal --system stage must run as root.\n' >&2
        exit 2
    fi

    local packages_to_remove=()
    local package
    local app_installer

    systemctl disable --now midscroll.service 2>/dev/null || true

    for package in midscroll xmousepasteblock xmousepasteblock-debug; do
        if pacman -Q "$package" &>/dev/null; then
            packages_to_remove+=("$package")
        fi
    done
    if (( ${#packages_to_remove[@]} )); then
        pacman -Rns --noconfirm "${packages_to_remove[@]}"
    fi

    if [[ -f /etc/midscroll.conf ]] &&
        grep -Fqx '# Managed by https://github.com/tomjseery/dotfiles.' \
            /etc/midscroll.conf; then
        rm -f -- /etc/midscroll.conf
    fi

    for app_installer in "$repo_root"/app-configs/*/install-system; do
        [[ -x $app_installer ]] || continue
        "$app_installer"
    done
}

if [[ ${1-} == --system ]]; then
    install_system_config
    exit 0
fi

if [[ $# -ne 0 ]]; then
    printf 'usage: %s\n' "${0##*/}" >&2
    exit 2
fi

if [[ $EUID -eq 0 ]]; then
    printf 'Run this installer as your normal desktop user; it opens a graphical administrator prompt when needed.\n' >&2
    exit 2
fi

for required_file in "$input_remapper_policy" "$input_remapper_merger"; do
    if [[ ! -f $required_file ]]; then
        printf 'Required repository file is missing: %s\n' "$required_file" >&2
        exit 1
    fi
done

aur_packages=()
for package_file in "$repo_root"/app-configs/*/aur-packages; do
    [[ -f $package_file ]] || continue
    while IFS= read -r package; do
        [[ -n $package && $package != \#* ]] && aur_packages+=("$package")
    done < "$package_file"
done

missing_aur_packages=()
for package in "${aur_packages[@]}"; do
    if ! pacman -Q "$package" &>/dev/null; then
        missing_aur_packages+=("$package")
    fi
done
if (( ${#missing_aur_packages[@]} )); then
    if ! command -v yay &>/dev/null; then
        printf 'yay is required to install: %s\n' "${missing_aur_packages[*]}" >&2
        exit 1
    fi
    yay --sudo pkexec -S --needed --noconfirm "${missing_aur_packages[@]}"
fi

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
input_remapper_config="$config_home/input-remapper-2/config.json"
python3 "$input_remapper_merger" "$input_remapper_policy" "$input_remapper_config"

if command -v input-remapper-control &>/dev/null; then
    if ! input-remapper-control --command stop-all \
        --config-dir "$(dirname "$input_remapper_config")"; then
        printf 'Warning: input-remapper was not reachable; its autoload map is still cleared on disk.\n' >&2
    fi
fi

# Remove every retired global MMB processor before enabling app-native support.
systemctl --user disable --now \
    midscroll-overlay.service \
    xmousepasteblock.service 2>/dev/null || true
systemctl --user stop app-xmousepasteblock@autostart.service 2>/dev/null || true
pkill -x xmousepasteblock 2>/dev/null || true
rm -f -- "$config_home/autostart/xmousepasteblock.desktop"
systemctl --user daemon-reload

pkexec "$script_path" --system

for app_installer in "$repo_root"/app-configs/*/install-user; do
    [[ -x $app_installer ]] || continue
    "$app_installer"
done

printf '\nMouse configuration applied.\n'
printf '  global input grab: disabled\n'
printf '  Chromium/Electron/CEF: native autoscroll enabled\n'
printf '  Thunderbird: native Gecko preferences installed\n'
printf '  input-remapper autoload: empty; running injections stopped\n'
printf '  restart open applications to load their native configuration\n'
