# Managed by https://github.com/tomjseery/dotfiles.
# Generated by install-mouse-config from app-configs/*/midscroll-pass-through.

# Chromium/Edge's Windows autoscroll speed curve:
# speed (px/sec) = SPEED_MULT * (pixels dragged) ^ SPEED_EXP per axis.
DEADZONE_PX = 15
SPEED_MULT = 0.008
SPEED_EXP = 2.2
MAX_PX_PER_SEC = 30000
PX_PER_NOTCH = 55
MAX_DRAG_PX = 1200
TICK_HZ = 90
NATURAL = false

# One middle click starts autoscroll. Another mouse click stops it.
TOGGLE_MODE = true

# Do not take middle clicks from the Plasma desktop or panels.
DESKTOP_SCROLL = false

# The per-user midscroll-overlay service reports the focused application so
# BLACKLIST can hand MMB to apps declared as native in their own app module.
# It also draws midscroll's fallback overlay in a Plasma Wayland session.
GHOST_CURSOR = true
GHOST_SCALE = 1.0
SNAP_CURSOR_ON_RELEASE = true

# Generated from every app-configs/*/midscroll-pass-through manifest.
# Matching is case-insensitive against the focused window's WM_CLASS/app id.
BLACKLIST = @MIDSCROLL_PASS_THROUGH@

EXTRA_DEVICES =

# input-remapper creates this virtual device even when no preset is injected.
# Ignoring it prevents a grab loop/conflict if input-remapper is used later.
IGNORE_DEVICES = input-remapper mouse
