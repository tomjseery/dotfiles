#!/usr/bin/env bash
set -euo pipefail

integration_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source_stylesheet="$integration_dir/styling/userChrome.css"
profiles_root="$HOME/.thunderbird"

if [[ ! -f $source_stylesheet ]]; then
    printf 'Missing Thunderbird stylesheet: %s\n' "$source_stylesheet" >&2
    exit 1
fi

[[ -d $profiles_root ]] || exit 0

while IFS= read -r -d '' prefs_file; do
    profile_dir=${prefs_file%/prefs.js}
    legacy_stylesheet="$profile_dir/chrome/userContent.css"

    # Remove the short-lived managed content stylesheet from older revisions.
    # Never remove a user-owned userContent.css.
    if [[ -f $legacy_stylesheet ]] &&
        grep -Fqx '/* Managed by https://github.com/tomjseery/dotfiles. */' \
            "$legacy_stylesheet"; then
        rm -f -- "$legacy_stylesheet"
    fi

    install -D -m 0644 \
        "$source_stylesheet" \
        "$profile_dir/chrome/userChrome.css"
done < <(find "$profiles_root" -mindepth 2 -maxdepth 2 -type f -name prefs.js -print0)
