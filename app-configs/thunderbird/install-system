#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    printf 'Thunderbird system integration must run as root.\n' >&2
    exit 2
fi

integration_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source_dir="$integration_dir/middle-click-autoscroll"
caller_source="$source_dir/autoconfig.js"
config_source="$source_dir/thunderbird.cfg"

[[ -d /usr/lib/thunderbird/defaults/pref ]] || exit 0

for required_file in "$caller_source" "$config_source"; do
    if [[ ! -f $required_file ]]; then
        printf 'Missing Thunderbird integration file: %s\n' "$required_file" >&2
        exit 1
    fi
done

if ! cmp -s \
    "$caller_source" \
    /usr/lib/thunderbird/defaults/pref/tomjseery-autoscroll.js; then
    install -o root -g root -m 0644 \
        "$caller_source" \
        /usr/lib/thunderbird/defaults/pref/tomjseery-autoscroll.js
fi

if ! cmp -s \
    "$config_source" \
    /usr/lib/thunderbird/tomjseery-autoscroll.cfg; then
    install -o root -g root -m 0644 \
        "$config_source" \
        /usr/lib/thunderbird/tomjseery-autoscroll.cfg
fi
